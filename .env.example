# Server-only /opt/driver-settlement/.env (placeholders; real values are never committed)
NEXT_PUBLIC_API_BASE_URL=https://<domain>/driver-settlement/api
CORS_ORIGIN=https://<domain>
PUBLIC_BASE_URL=https://<domain>/driver-settlement/api
MONGO_URI=mongodb://<user>:<password>@mongodb:27017/driver_settlement?authSource=admin
JWT_SECRET=<change-me>
JWT_EXPIRES_IN=8h
RSOP_USERNAME=RSOP
RSOP_PASSWORD=<change-me>
RBP_USERNAME=RBP
RBP_PASSWORD=<change-me>
RSOM_USERNAME=RSOM
RSOM_PASSWORD=<change-me>
RSA_USERNAME=RSA
RSA_PASSWORD=<change-me>
RSO_USERNAME=RSO
RSO_PASSWORD=<change-me>
STORAGE_TYPE=local
