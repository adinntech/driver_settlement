# local: localhost API, no base path. live: https://adinntech.in/driver-settlement (+ /api)
NEXT_PUBLIC_ENVIRONMENT=local
# Optional overrides (normally leave unset)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
# NEXT_PUBLIC_BASE_PATH=

# Feature flag: on = Roadshow and Signage; off (default) = Signage only. Must match ROADSHOW in backend/.env.
# Rebuild (or restart the dev server) after changing it.
NEXT_PUBLIC_ROADSHOW=on
