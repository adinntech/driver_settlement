NODE_ENV=development
PORT=5000
# Only this origin is allowed by CORS
CORS_ORIGIN=http://localhost:3000

MONGO_URI=mongodb://127.0.0.1:27017/driver_settlement

JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
# Seed users (created once if missing; stored hashed)
RSOP_USERNAME=RSOP
RSOP_PASSWORD=
RBP_USERNAME=RBP
RBP_PASSWORD=
RSOM_USERNAME=RSOM
RSOM_PASSWORD=
RSA_USERNAME=RSA
RSA_PASSWORD=
# RSO (final settlement approvals + reports) is a separate login from RSOM
RSO_USERNAME=RSO
RSO_PASSWORD=
# Optional: key for encrypting bank / payment details at rest (defaults to a key derived from JWT_SECRET)
#DATA_ENCRYPTION_KEY=
# Company name printed on the driver salary PDF
#COMPANY_NAME=ADINN
# File storage: local (backend/public) or space (cloud bucket)
STORAGE_TYPE=local
PUBLIC_BASE_URL=http://localhost:5000
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_BUCKET=
DO_SPACES_CDN_BASE=

# How often (ms) vehicles past their next-available time are marked Available again (default 60000)
#AVAILABILITY_JOB_INTERVAL_MS=60000
# Development only: show each role's demo login on the login page (ignored when NODE_ENV=production)
#DEMO_LOGIN_HINTS=true
# Toll plaza directory used by the RBP budget form (no key needed). Defaults shown.
#TOLL_DATA_URL=https://raw.githubusercontent.com/ForceGT/india-toll-plazas/main/data/latest.json
#TOLL_DATA_TTL_HOURS=24
#TOLL_CACHE_FILE=./.cache/toll-plazas.json

# Feature flag: on = Roadshow and Signage; off (default, also when missing or invalid) = Signage only.
# Must match NEXT_PUBLIC_ROADSHOW in frontend/.env.local. Restart the server after changing it.
ROADSHOW=on

# Scheduled MongoDB backup (00:00, 06:00, 12:00, 18:00 IST) to the DO_SPACES_* Space above, folder
# driver_settlement/database-backups/YYYY-MM-DD/ (private). Needs the DO_SPACES_* keys even when STORAGE_TYPE=local.
#BACKUP_ENABLED=true
# Health report at the same times + alerts when something breaks (checked every HEALTH_CHECK_INTERVAL_MINUTES)
#HEALTH_MONITOR_ENABLED=true
# Google Chat space webhook (Apps & integrations > Webhooks). Server only; never commit it.
#GOOGLE_CHAT_WEBHOOK_URL=
# Name shown as "Server:" in the messages
#SERVER_NAME=driver-settlement
# Local copy of each backup (default backend/backups) and how long backups are kept, locally and in the Space
#BACKUP_LOCAL_DIR=./backups
#BACKUP_RETENTION_DAYS=7
# Comma separated URLs checked by the health monitor (HTTP 5xx or no answer = alert)
#HEALTH_CHECK_URLS=https://adinntech.in/driver-settlement/login,https://adinntech.in/driver-settlement/api/health
#HEALTH_CHECK_INTERVAL_MINUTES=5
# While a problem stays active, repeat the alert this often
#HEALTH_ALERT_REPEAT_MINUTES=60
