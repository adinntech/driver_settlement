// Job: "driver-settlement" (Scripted Pipeline, one job for both services). Triggered by a push to main_build.
// main_build holds the source. The server builds each image with deploy/Dockerfile: tests (frontend + backend), then build.
// Deploys only the services whose source (or the shared deploy files) changed since the last successful run.
// The server does test + build + deploy in one command per service. That command runs in the background and each
// stage follows its output until its phase is over, so the stage view moves live. With two services, the second
// one runs entirely inside the Deploy stage (its tests come from the first one's cache).
// One Google Chat message per run (Secret text credential "google-chat-webhook"); reporting can never change the result.
// Trigger and concurrency are NOT set here: configure them on the job. This script changes no job property.

timestamps {
  node {
    withEnv(['DEPLOY_HOST=jenkins-deploy@172.17.0.1']) {
      def failedStage = 'Checkout'
      def checkedOut = false
      def selected = []
      def attempted = []
      def results = [:]
      def failure = ''
      def phaseNames = [['test', 'Test'], ['build', 'Build'], ['deploy', 'Deploy']]
      try {
        sh 'rm -f deploy-* gchat-payload.json'
        def scmVars = checkout([$class: 'GitSCM', branches: [[name: '*/main_build']],
          userRemoteConfigs: [[url: 'https://github.com/adinntech/driver_settlement.git', credentialsId: 'github-driver-settlement']]])
        def base = scmVars.GIT_PREVIOUS_SUCCESSFUL_COMMIT ?: 'HEAD~1'
        checkedOut = true

        failedStage = 'Changed paths'
        // a failing diff fails the build; an empty diff deploys nothing
        def diff = ''
        withEnv(["BASE_COMMIT=${base}"]) {
          diff = sh(returnStdout: true, script: 'git diff --name-only "$BASE_COMMIT" HEAD || git diff --name-only HEAD~1 HEAD').trim()
        }
        def files = diff.split('\n')
        def shared = files.any { it.startsWith('deploy/') || it == 'docker-compose.prod.yml' || it == '.dockerignore' }
        if (shared || files.any { it.startsWith('backend/') }) selected << 'backend'
        if (shared || files.any { it.startsWith('frontend/') }) selected << 'frontend'

        if (!selected) {
          for (phase in phaseNames) {
            stage(phase[1]) { notBuilt("${phase[1]}: no changes") }
          }
        } else {
          def first = selected[0]
          sshagent(credentials: ['jenkins-deploy-ssh']) {
            timeout(time: 60, unit: 'MINUTES') {
              for (phase in phaseNames) {
                def key = phase[0]
                def label = phase[1]
                stage(label) {
                  // keeps the first failing stage as the one reported
                  if (currentBuild.currentResult == 'SUCCESS') failedStage = label
                  if (!attempted) {
                    attempted << first
                    startDeploy(first)
                  }
                  follow(first, key)
                  def state = phases(readFile("deploy-${first}.log"), first)[key]
                  if (key == 'deploy') {
                    results[first] = outcome(first)
                    // the first failure stops the run: nothing after it is deployed
                    if (results[first].deploy == 'OK') {
                      for (int i = 1; i < selected.size(); i++) {
                        def svc = selected[i]
                        attempted << svc
                        startDeploy(svc)
                        follow(svc, 'deploy')
                        results[svc] = outcome(svc)
                        if (results[svc].deploy != 'OK') break
                      }
                    }
                    def values = []
                    for (svc in attempted) values << results[svc].deploy
                    // red when the deploy itself, or anything about a later service, failed; grey when tests or build did
                    def firstBuilt = results[first].test == 'OK' && results[first].build == 'OK'
                    state = combine(values) == 'OK' ? 'OK' : firstBuilt ? 'FAIL' : 'NOT_RUN'
                  }
                  if (state == 'FAIL') {
                    failedStage = label
                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') { error("${label} failed") }
                  } else if (state == 'NOT_RUN') {
                    notBuilt("${label} not run")
                  } else {
                    echo "${label} passed"
                  }
                }
              }
            }
          }
        }
      } catch (Throwable e) {
        // Scripted Pipeline has not set the result yet at this point, so record it here; the error is rethrown unchanged
        failure = e instanceof InterruptedException ? 'ABORTED' : 'FAILURE'
        throw e
      } finally {
        try {
          def status = failure ?: currentBuild.currentResult
          if (status == 'SUCCESS' && !selected) status = 'SKIPPED'
          def emoji = [SUCCESS: '✅', FAILURE: '❌', ABORTED: '⏹️', UNSTABLE: '⚠️', SKIPPED: '⏭️']
          def phaseEmoji = [OK: '✅ passed', FAIL: '❌ failed', NOT_RUN: '⏭️ not run']
          def commit = checkedOut ? sh(returnStdout: true, script: "git log -1 --format='%h — %s (%an)' 2>/dev/null || true").trim() : ''
          def now = sh(returnStdout: true, script: "TZ='IST-05:30' date '+%d %b %Y, %H:%M:%S IST'").trim()

          def out = []
          out << "${emoji[status] ?: 'ℹ️'} *driver-settlement — ${status}*"
          out << "Build #${env.BUILD_NUMBER} · main_build"
          out << "Commit: ${maskValues(commit ?: 'unknown (checkout did not complete)')}"
          out << ''
          for (phase in phaseNames) {
            def values = []
            for (svc in attempted) values << (results[svc] ? results[svc][phase[0]] : 'NOT_RUN')
            out << "${phase[1]}: ${phaseEmoji[combine(values)]}"
          }
          out << ''
          for (svc in ['backend', 'frontend']) {
            def result = results[svc]
            def line = !selected.contains(svc) ? '⏭️ no changes' : !attempted.contains(svc) ? '⏭️ not run' : (result && result.deploy == 'OK') ? '✅ deployed' : '❌ failed'
            out << "${svc == 'backend' ? 'Backend' : 'Frontend'}: ${line}"
          }
          if (!(status in ['SUCCESS', 'SKIPPED'])) {
            def last = attempted ? "deploy-${attempted[-1]}.log" : ''
            def log = (last && fileExists(last)) ? readFile(last) : ''
            out << ''
            out << "Failed at: ${failedStage}"
            out << "Error: ${log ? '\n' + errorDetails(log) : 'no deployment output; see the console'}"
          }
          out << ''
          out << "URL: https://adinntech.in/driver-settlement/"
          out << "${now} · ${currentBuild.durationString.replace(' and counting', '')}"
          if (env.BUILD_URL) out << "<${env.BUILD_URL}console|Open console>"

          writeFile(file: 'gchat-payload.json', text: groovy.json.JsonOutput.toJson([text: out.join('\n')]), encoding: 'UTF-8')
          withCredentials([string(credentialsId: 'google-chat-webhook', variable: 'GCHAT_WEBHOOK')]) {
            // single-quoted: the webhook is expanded by the shell only; curl output is discarded so it can never be logged
            sh '''set +x
curl -fsS --max-time 20 -X POST -H 'Content-Type: application/json; charset=UTF-8' --data-binary @gchat-payload.json "$GCHAT_WEBHOOK" >/dev/null 2>&1 || echo 'Google Chat notification could not be sent (build result unchanged)'
'''
          }
        } catch (Throwable err) {
          echo 'Google Chat notification skipped (build result unchanged)'
          // console only: names a missing plugin or a signature awaiting Script Approval
          try { echo "Reason: ${err.message}" } catch (Throwable ignored) { echo 'Reason unavailable' }
        } finally {
          try { sh 'rm -f deploy-* gchat-payload.json' } catch (Throwable err) { echo 'could not remove notification files' }
        }
      }
    }
  }
}

/** Greys a stage out; buildResult SUCCESS never changes the build result. */
def notBuilt(String reason) {
  catchError(buildResult: 'SUCCESS', stageResult: 'NOT_BUILT') { error(reason) }
}

/** Starts the server deploy in the background: output goes to deploy-<svc>.log, its exit code to deploy-<svc>.rc. */
def startDeploy(String svc) {
  withEnv(["SVC=${svc}"]) {
    sh '''#!/usr/bin/env bash
rm -f "deploy-$SVC.rc" "deploy-$SVC.pos"
: > "deploy-$SVC.log"
JENKINS_NODE_COOKIE=dontKillMe nohup bash -c 'ssh -n -o BatchMode=yes -o StrictHostKeyChecking=yes -o ServerAliveInterval=30 "$DEPLOY_HOST" sudo -n /opt/deploy/deploy-driver-settlement.sh "$SVC" > "deploy-$SVC.log" 2>&1; echo $? > "deploy-$SVC.rc"' > /dev/null 2>&1 &
'''
  }
}

/** Prints the new deploy output until the phase (test, build or deploy) is over or the command has ended. */
def follow(String svc, String phase) {
  withEnv(["SVC=${svc}", "PHASE=${phase}"]) {
    sh '''#!/usr/bin/env bash
set +x
log="deploy-$SVC.log"
pos=$(cat "deploy-$SVC.pos" 2>/dev/null || echo 0)
while true; do
  ended=no
  [ -s "deploy-$SVC.rc" ] && ended=yes   # checked before printing, so the last lines are not missed
  total=$(wc -l < "$log")
  if [ "$total" -gt "$pos" ]; then sed -n "$((pos + 1)),${total}p" "$log"; pos=$total; echo "$pos" > "deploy-$SVC.pos"; fi
  [ "$ended" = yes ] && break
  step=$(grep -m1 -E '^#[0-9]+ [[][^]]*tests [0-9]+/[0-9]+] RUN ' "$log" | cut -d' ' -f1)
  case "$PHASE" in
    test) [ -n "$step" ] && grep -qE "^$step (DONE|CACHED|ERROR)" "$log" && break ;;
    build) grep -qF -e "naming to docker.io/library/driver-settlement-$SVC:latest done" -e "Container driver-settlement-$SVC " "$log" && break ;;
  esac
  sleep 5
done
'''
  }
}

/** Test / build / deploy result of a finished deploy command. */
def outcome(String svc) {
  def result = phases(readFile("deploy-${svc}.log"), svc)
  def code = readFile("deploy-${svc}.rc").trim()
  if (code != '0' && result.deploy == 'OK') result.deploy = 'FAIL'
  return result
}

/** Test / build / deploy outcome of one service, read from the deploy script output (docker plain progress). */
@NonCPS
Map phases(String log, String svc) {
  def lines = log.readLines()
  String step = ''
  for (line in lines) {
    def m = line =~ /^(#\d+) \[[^\]]*tests \d+\/\d+\] RUN /
    if (m.find()) { step = m.group(1); break }
  }
  boolean testOk = step != '' && lines.any { it == step + ' CACHED' || it.startsWith(step + ' DONE') }
  boolean deployOk = lines.any { it.startsWith('healthy: ') }
  boolean buildOk = deployOk || log.contains('naming to docker.io/library/driver-settlement-' + svc + ':latest done') || log.contains('Container driver-settlement-' + svc + ' ')
  if (deployOk) return [test: 'OK', build: 'OK', deploy: 'OK']
  if (buildOk) return [test: 'OK', build: 'OK', deploy: 'FAIL']
  if (testOk) return [test: 'OK', build: 'FAIL', deploy: 'NOT_RUN']
  if (step != '') return [test: 'FAIL', build: 'NOT_RUN', deploy: 'NOT_RUN']
  // stopped before the tests (git, npm ci, image download, server checks)
  return [test: 'NOT_RUN', build: 'FAIL', deploy: 'NOT_RUN']
}

/** One status for a phase across the services that were run. */
@NonCPS
String combine(List values) {
  if (values.contains('FAIL')) return 'FAIL'
  return (values && !values.contains('NOT_RUN')) ? 'OK' : 'NOT_RUN'
}

/** Masks recognisable secret values; used as is for commit subjects and build causes. */
@NonCPS
String maskValues(String s) {
  s.replaceAll(/\u001B\[[0-9;]*[A-Za-z]/, '')
    .replaceAll('<', '‹').replaceAll('>', '›')
    .replaceAll(/(?i)mongodb(\+srv)?:\/\/\S+/, '[database url]')
    .replaceAll(/(?i)https:\/\/chat\.googleapis\.com\S*/, '[webhook]')
    .replaceAll(/(?i)\b([a-z][a-z0-9+.-]*):\/\/[^\s\/@]+@/, '$1://[credentials]@')
    .replaceAll(/(?i)\bbearer\s+\S+/, 'Bearer [hidden]')
    .replaceAll(/(?i)([A-Z0-9_-]*(password|passwd|passphrase|pwd|secret|token|api[_-]?key|webhook|mongo_uri|username)[A-Z0-9_-]*)["']?\s*[=:]\s*("[^"]*"|'[^']*'|\S+)/, '$1=[hidden]')
    .replaceAll(/eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+/, '[token]')
    .replaceAll(/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}/, '[email]')
}

/**
 * For deployment output: a line that mentions a secret is dropped whole, whatever its format.
 * Keeps one output line per input line.
 */
@NonCPS
String sanitize(String s) {
  def out = []
  boolean inKey = false
  boolean hideNext = false
  for (line in s.split('\n', -1)) {
    boolean named = (line =~ /(?i)(passw|passphrase|\bpass\b|pwd|secret|token|api[_ -]?key|access[_ -]?key|private[_ -]?key|webhook|mongo(db)?_ur[il]|database_url|user[_ ]?name|authorization|bearer|credential|cookie|jwt)/).find()
    if (line.contains('-----BEGIN')) inKey = true
    boolean hide = inKey || named || hideNext
    out << (hide ? '[line hidden: possible secret]' : maskValues(line))
    if (line.contains('-----END')) inKey = false
    // a value that continues on the following line
    hideNext = (named || hideNext) && (line =~ /[:=\[{(\\|>]\s*["']?\s*$/).find()
  }
  return out.join('\n')
}

/** A few relevant lines of the output (errors and the script's own messages), sanitized and short. */
@NonCPS
String errorDetails(String log) {
  def raw = log.split('\n', -1)
  def safe = sanitize(log).split('\n', -1)
  def picked = []
  def others = []
  for (int i = 0; i < raw.size(); i++) {
    if (!raw[i].trim()) continue
    others << safe[i].trim()
    if ((raw[i] =~ /(?i)(error|fail|fatal|denied|refused|not running|missing|cannot|timeout|unhealthy|exit code|^Rollback:)/).find()) picked << safe[i].trim()
  }
  def lines = picked ?: others
  if (!lines) return 'no deployment output; see the console'
  def last = []
  for (int i = Math.max(0, lines.size() - 8); i < lines.size(); i++) last << lines[i].take(200)
  return last.join('\n').take(900)
}
